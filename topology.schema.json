{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/skyzhao1223/toposky/topology.schema.json",
  "title": "TopoSky Dataset",
  "description": "系统拓扑图谱的数据格式。示例见 examples/demo/topology.json。本 schema 只约束结构与枚举；引用完整性、词表一致性等语义规则由 `npm run validate`（scripts/validate-topology.mjs）负责，两者互补。",
  "type": "object",
  "required": ["nodes", "relations"],
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "nodes": {
      "type": "array",
      "description": "节点：能改、能发布、能挂掉的最小单位",
      "items": { "$ref": "#/definitions/node" }
    },
    "relations": {
      "type": "array",
      "description": "依赖关系（调用/依赖/消息/同步/部署）",
      "items": { "$ref": "#/definitions/relation" }
    },
    "systems": {
      "type": "array",
      "description": "系统注册表（业务与台账认账的单位，1—N 个节点）",
      "items": { "$ref": "#/definitions/system" }
    },
    "entryRoutes": {
      "type": "array",
      "description": "入口层：域名 → 路径 → 后端应用",
      "items": { "$ref": "#/definitions/entryRoute" }
    },
    "businessFlows": {
      "type": "array",
      "description": "端到端业务流",
      "items": { "$ref": "#/definitions/businessFlow" }
    },
    "businessLines": {
      "type": "array",
      "description": "业务线词表（可选；未声明时使用内置默认）",
      "items": { "$ref": "#/definitions/businessLine" }
    },
    "businessLineGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "children"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": "string" },
          "description": { "type": "string" },
          "children": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "domains": {
      "type": "array",
      "description": "业务域词表（声明后即权威值域）",
      "items": { "$ref": "#/definitions/domain" }
    },
    "processHosts": {
      "type": "array",
      "description": "流程宿主引擎词表（声明后即权威值域）",
      "items": { "$ref": "#/definitions/processHost" }
    },
    "processCatalog": { "$ref": "#/definitions/processCatalog" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "enum": ["access", "application", "platform", "middleware", "infrastructure", "external"] },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "order": { "type": "number" }
        }
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "name", "description", "category"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": { "type": "string", "description": "兼容字段；新数据请用 layer", "enum": ["platform", "middleware", "application", "infrastructure", "external"] },
        "layer": { "type": "string", "enum": ["access", "application", "platform", "middleware", "infrastructure", "external"] },
        "appType": { "type": "string", "enum": ["frontend", "backend", "bff", "fullstack"] },
        "businessLine": { "type": "string" },
        "owner": { "type": "string", "description": "内部团队/负责人（外部系统请用 vendor + contacts）" },
        "vendor": { "type": "string" },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "phone": { "type": "string" },
              "email": { "type": "string" },
              "im": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "repo": { "type": "string" },
            "ones": { "type": "string" },
            "wiki": { "type": "string" },
            "ci": { "type": "string" },
            "monitoring": { "type": "string" }
          }
        },
        "environments": {
          "type": "object",
          "properties": {
            "dev": { "$ref": "#/definitions/env" },
            "test": { "$ref": "#/definitions/env" },
            "staging": { "$ref": "#/definitions/env" },
            "production": { "$ref": "#/definitions/env" }
          }
        },
        "systemId": { "type": "string", "description": "归属系统 id（指向 systems[]）" },
        "systemPrimary": { "type": "boolean", "description": "每个 systemId 至多一个代表节点" },
        "repoPath": { "type": "string", "description": "仓库内模块路径（一个仓库装多个系统时定位用）" },
        "color": { "type": "string" },
        "url": { "type": "string" },
        "position": {
          "type": "object",
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
        }
      }
    },
    "env": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "url": { "type": "string" },
        "deployUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["running", "stopped", "degraded", "unknown"] },
        "version": { "type": "string" },
        "replicas": { "type": "number" },
        "lastDeploy": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "source", "target", "relationType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "relationType": { "type": "string", "enum": ["depends_on", "calls", "publishes_to", "subscribes_from", "syncs_with", "deploys_to"] },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "environments": {
          "type": "array",
          "items": { "type": "string", "enum": ["dev", "test", "staging", "production"] }
        },
        "contract": {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["http", "rpc", "mq", "db", "file", "other"] },
            "target": { "type": "string", "description": "接口路径 / 方法名 / topic / 表名等具体落点" },
            "note": { "type": "string" }
          }
        },
        "scope": { "type": "string", "enum": ["node", "system"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low", "doubtful"] },
        "evidence": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "enum": ["code", "config", "gateway", "nacos", "ledger", "doc", "inference"] },
            "ref": { "type": "string", "description": "可定位出处，如 pom.xml:61 / application-prod.yaml:24" },
            "note": { "type": "string" },
            "verdict": { "type": "string", "enum": ["supports", "weak", "absent", "refutes"] },
            "verifiedAt": { "type": "string" },
            "pendingData": { "type": "string", "enum": ["P0-gateway", "external-config", "manual"] }
          }
        }
      }
    },
    "system": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "businessLine": { "type": "string" },
        "documented": { "type": "boolean" }
      }
    },
    "entryRoute": {
      "type": "object",
      "required": ["env", "domain", "path"],
      "properties": {
        "env": { "type": "string", "description": "入口环境（如 prod / test；值域由采集端定义）" },
        "domain": { "type": "string" },
        "path": { "type": "string", "description": "路径匹配式，支持 * 通配" },
        "priority": { "type": "number" },
        "target": { "type": "string", "description": "后端应用/上游组" },
        "appId": { "type": "number" },
        "https": { "type": "boolean", "description": "false 表示未强制 HTTPS；缺省视为已强制" },
        "nodeId": { "type": "string", "description": "能对应到的图谱节点；映射不确定时留空" }
      }
    },
    "businessFlow": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "businessLine": { "type": "string" },
        "domain": { "type": "string" },
        "owner": { "type": "string" },
        "criticality": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "trigger": { "type": "string" },
        "kpi": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nodeId"],
            "properties": { "nodeId": { "type": "string" }, "label": { "type": "string" } }
          }
        }
      }
    },
    "businessLine": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "group": { "type": "string" },
        "domain": { "type": "string", "description": "主责业务域（用于按域分列时的单一主域判定）" }
      }
    },
    "domain": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "color": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" }
      }
    },
    "processHost": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "processCatalog": {
      "type": "object",
      "required": ["domains", "dependencies"],
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "groups"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "nameEn": { "type": "string" },
              "groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name", "processes"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "nameEn": { "type": "string" },
                    "processes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "name"],
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "nameEn": { "type": "string" },
                          "desc": { "type": "string" },
                          "systems": { "type": "array", "items": { "type": "string" } },
                          "flows": { "type": "array", "items": { "type": "string" } },
                          "host": { "type": "string", "description": "宿主引擎 id（值域见 processHosts）" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "type": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
